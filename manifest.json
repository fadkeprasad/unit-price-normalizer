{
  "manifest_version": 3,
  "name": "Unit Price Normalizer",
  "version": "1.0.0",
  "description": "Compare product prices using a consistent price per gram or milliliter.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Unit Price Normalizer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["normalizer.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
